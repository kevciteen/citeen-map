{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd app && npm install --include=dev && npm run build",
  "installCommand": "echo 'install happens in buildCommand'",
  "outputDirectory": "app/.next",
  "crons": [
    { "path": "/api/cron/relances", "schedule": "0 7 * * *" },
    { "path": "/api/cron/backup", "schedule": "0 3 * * *" }
  ]
}
